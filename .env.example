# SenseVoice 配置
# 設備類型：cuda（NVIDIA GPU）或 cpu
DEVICE=cuda

# GPU 設備 ID（0 = 第一張 GPU）
CUDA_VISIBLE_DEVICES=0
GPU_DEVICE_ID=0

# SenseVoice API 端口（內部網絡）
API_PORT=10095

# 繁體轉換代理端口（對外暴露）
PROXY_PORT=10096

# OpenCC 轉換規則
# s2hk = 簡體→香港繁體（推薦，澳門/香港適用）
# s2tw = 簡體→台灣繁體
# s2t = 簡體→繁體（通用）
OPENCC_CONFIG=s2hk

# 模型名稱
MODEL_NAME=sensevoice-small
